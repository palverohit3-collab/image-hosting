<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📸 Birthday Gallery</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(45deg, #ff9a9e 0%, #fecfef 50%, #fecfef 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
        }

        .title {
            font-size: 3rem;
            color: white;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
            margin-bottom: 20px;
            animation: slideDown 1s ease;
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* --- Gallery Grid --- */
        .gallery-grid {
            display: grid;
            /* Responsive grid: as many columns as possible, each at least 300px wide */
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
            gap: 30px;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .gallery-item {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .gallery-item:hover {
            transform: scale(1.05) rotate(2deg);
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            z-index: 10;
        }

        .gallery-item:nth-child(even):hover {
            transform: scale(1.05) rotate(-2deg);
        }

        /* --- Image Styling (The fix is here) --- */
        .gallery-item img {
            width: 100%;
            height: 350px; /* Set a consistent height */
            object-fit: cover; /* FIX: Makes image fill container without stretching */
            border-radius: 20px 20px 0 0; /* Match container top corners */
            display: block;
            transition: all 0.3s ease;
        }
        
        .gallery-item:hover img {
            transform: scale(1.1);
            filter: brightness(1.1);
        }
        
        /* --- Caption/Text Styling --- */
        .gallery-text {
            background-color: white;
            padding: 15px;
            text-align: center;
        }

        .gallery-text h3 {
            margin: 5px 0;
            font-size: 1.3rem;
            color: #ff6b9d; /* Pink text for titles */
        }

        .gallery-text p {
            margin: 0;
            color: #666;
            font-size: 0.95rem;
        }

        /* --- Navigation --- */
        .navigation {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 20px;
            background: rgba(255,255,255,0.2);
            padding: 15px 30px;
            border-radius: 25px;
            backdrop-filter: blur(10px);
            z-index: 20;
        }

        .nav-btn {
            background: linear-gradient(45deg, #ff6b9d, #c44569);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 20px;
            text-decoration: none;
            font-weight: bold;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .nav-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        /* --- Sparkle Effect --- */
        .sparkle {
            position: absolute;
            color: gold;
            font-size: 1rem;
            animation: sparkleFloat 3s infinite ease-in-out;
            pointer-events: none;
        }

        @keyframes sparkleFloat {
            0%, 100% {
                transform: translateY(0) rotate(0deg);
                opacity: 1;
            }
            50% {
                transform: translateY(-20px) rotate(180deg);
                opacity: 0.7;
            }
        }

        @media (max-width: 768px) {
            .title {
                font-size: 2rem;
            }
            .gallery-grid {
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                gap: 20px;
            }
            .navigation {
                flex-direction: column;
                align-items: center;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1 class="title">📸 Memory Gallery 📸</h1>
        <p style="color: white; font-size: 1.2rem;">Beautiful moments captured forever!</p>
    </div>

    <div class="gallery-grid" id="galleryGrid">
        <div class="gallery-item">
            <img src="https://raw.githubusercontent.com/palverohit3-collab/image-hosting/refs/heads/main/508327670_18046511942624818_3088697812522590264_n.jpg" alt="Birthday Balloons">
            <div class="gallery-text">
                <h3>Birthday Balloons</h3>
                <p>Colorful celebrations!</p>
            </div>
        </div>

        <div class="gallery-item">
            <img src="https://raw.githubusercontent.com/palverohit3-collab/image-hosting/refs/heads/main/1757863349379.jpg" alt="Birthday Cake">
            <div class="gallery-text">
                <h3>Birthday Cake</h3>
                <p>Sweet moments together!</p>
            </div>
        </div>

        <div class="gallery-item">
            <img src="https://i.pinimg.com/736x/0c/df/55/0cdf5516103bc4cfc6686e19d4af1e24.jpg" alt="Special Gifts">
            <div class="gallery-text">
                <h3>Special Gifts</h3>
                <p>Surprises and joy!</p>
            </div>
        </div>

        <div class="gallery-item">
            <img src="https://i.pinimg.com/1200x/2d/df/9c/2ddf9ccb616327c5b3c6baac03dee8d1.jpg" alt="Magical Moments">
            <div class="gallery-text">
                <h3>Magical Moments</h3>
                <p>Unforgettable memories!</p>
            </div>
        </div>

        <div class="gallery-item">
            <img src="https://i.pinimg.com/736x/e0/f0/2c/e0f02cec60622ec7cdf7cacdf4adfb7a.jpg" alt="Love & Care">
            <div class="gallery-text">
                <h3>Love & Care</h3>
                <p>Precious times!</p>
            </div>
        </div>

        <div class="gallery-item">
            <img src="https://i.pinimg.com/736x/23/47/3b/23473b831b083e0534acbb5d53a18b6a.jpg" alt="Celebration">
            <div class="gallery-text">
                <h3>Celebration</h3>
                <p>Party time fun!</p>
            </div>
        </div>
    </div>

    <div class="navigation">
        <a href="index.html" class="nav-btn">🏠 Home</a>
        <a href="message.html" class="nav-btn">💌 Message</a>
        <a href="surprise.html" class="nav-btn">🎁 Surprise</a>
    </div>

    <script>
        // Add sparkles randomly
        function createSparkle() {
            const sparkle = document.createElement('div');
            sparkle.className = 'sparkle';
            sparkle.innerHTML = '✨';
            sparkle.style.left = Math.random() * 100 + '%';
            sparkle.style.top = Math.random() * 100 + '%';
            
            document.body.appendChild(sparkle);
            
            setTimeout(() => {
                sparkle.remove();
            }, 3000);
        }

        // Create sparkles continuously
        setInterval(createSparkle, 1000);

        // Add hover effect simulation (removed unnecessary filter change)
        document.querySelectorAll('.gallery-item').forEach(item => {
            item.addEventListener('mouseenter', () => {
                // Your CSS handles the hover transform, no need for JS filter here
            });
            
            item.addEventListener('mouseleave', () => {
                // Your CSS handles the hover transform
            });
        });

        // Add click effect
        document.querySelectorAll('.gallery-item').forEach(item => {
            item.addEventListener('click', () => {
                // Temporarily override the CSS transform for a quick click feedback
                const originalTransform = item.style.transform;
                item.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    item.style.transform = originalTransform;
                }, 150);
            });
        });
    </script>
</body>
</html>

